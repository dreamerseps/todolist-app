              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "code": { "type": "string", "example": "SUCCESS" },
                    "message": { "type": "string", "example": "카테고리가 삭제되었습니다." }
