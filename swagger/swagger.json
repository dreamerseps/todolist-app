    "/api/todos": {
      "get": {
        "tags": ["Todos"],
        "summary": "할일 목록 조회",
        "description": "현재 사용자의 할일 목록을 조회합니다. 필터링·정렬·페이지네이션을 지원합니다 (BR-06).\n\n**정렬 기준:**\n- `created_at` (기본값): 등록일시 내림차순\n- `due_date`: 종료 예정일 오름차순\n\n**페이지네이션:**\n- 기본 20건, 최대 100건",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "category_id",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "uuid" },
            "description": "특정 카테고리 필터 (BR-06)"
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date" },
            "description": "종료 예정일 범위 시작 (YYYY-MM-DD, BR-06)"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date" },
            "description": "종료 예정일 범위 종료 (YYYY-MM-DD, BR-06). from <= to 이어야 함"
          },
          {
            "name": "is_completed",
            "in": "query",
            "required": false,
            "schema": { "type": "boolean" },
            "description": "완료 여부 필터 (BR-06). true=완료, false=미완료, 생략=전체"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["created_at", "due_date"],
              "default": "created_at"
            },
            "description": "정렬 기준 (created_at: 등록일시 DESC, due_date: 마감일 ASC)"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "default": 1 },
            "description": "페이지 번호 (1부터 시작)"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 },
            "description": "페이지당 항목 수 (기본 20, 최대 100)"
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TodoListResponse" },
                "example": {
                  "success": true,
                  "code": "SUCCESS",
                  "data": {
                    "todos": [
                      {
                        "id": "todo-uuid-1",
                        "user_id": "user-uuid",
                        "category_id": "category-uuid",
                        "title": "주간 보고서 작성",
                        "description": "1분기 실적 포함",
                        "due_date": "2026-05-15",
                        "is_completed": false,
                        "created_at": "2026-05-13T09:00:00Z",
                        "updated_at": "2026-05-13T09:00:00Z"
                      }
                    ],
                    "pagination": {
                      "page": 1,
                      "limit": 20,
                      "total": 45,
                      "total_pages": 3
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["Todos"],
        "summary": "할일 등록",
        "description": "새로운 할일을 등록합니다.\n\n- **BR-05**: category_id 필수\n- **BR-02**: 접근 가능한 카테고리(기본 또는 자신의 카테고리)만 지정 가능",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TodoCreateRequest" },
              "example": {
                "title": "주간 보고서 작성",
                "description": "1분기 실적 포함하여 작성",
                "category_id": "category-uuid",
                "due_date": "2026-05-15"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "등록 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "code": { "type": "string", "example": "CREATED" },
                    "message": { "type": "string", "example": "할일이 등록되었습니다." },
                    "data": { "$ref": "#/components/schemas/Todo" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "category_id 누락(BR-05) 또는 유효성 오류",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": {
                  "success": false,
                  "code": "BAD_REQUEST",
                  "message": "카테고리는 필수 항목입니다."
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": {
            "description": "지정한 카테고리가 존재하지 않거나 접근 불가",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
