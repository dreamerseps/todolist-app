{
  "openapi": "3.0.3",
  "info": {
    "title": "TodoListApp API",
    "description": "TodoListApp REST API 명세서\n\n## 인증\n모든 보호된 엔드포인트는 `Authorization: Bearer {accessToken}` 헤더가 필요합니다.\n- **Access Token**: 15분 만료, Zustand 메모리 저장\n- **Refresh Token**: 7일 만료, Zustand 메모리 저장\n\n## 주요 비즈니스 규칙\n- **BR-02**: 사용자는 자신의 데이터만 조회·수정·삭제 가능\n- **BR-05**: 할일 등록 시 카테고리 필수\n- **BR-07**: 이메일 중복 등록 불가\n- **BR-08**: 할일이 있는 카테고리 삭제 불가\n- **BR-09**: 이메일은 가입 후 변경 불가",
    "version": "1.0.0",
    "contact": {
      "name": "yoseb lee"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "로컬 개발 서버"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "인증 — 회원가입, 로그인, 토큰 갱신, 로그아웃"
    },
    {
      "name": "Users",
      "description": "사용자 정보 조회 및 수정"
    },
    {
      "name": "Categories",
      "description": "카테고리 CRUD (기본 카테고리 보호 포함)"
    },
    {
      "name": "Todos",
      "description": "할일 CRUD, 필터링, 정렬, 페이지네이션"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "로그인 후 발급된 Access Token (15분 만료)"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "사용자 고유 식별자"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "이메일 (로그인 식별자, 변경 불가 BR-09)"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "description": "사용자 이름"
          },
          "provider": {
            "type": "string",
            "enum": ["local", "google", "facebook"],
            "default": "local",
            "description": "인증 제공자"
          },
          "provider_id": {
            "type": "string",
            "nullable": true,
            "description": "OAuth 제공자 사용자 ID (local 인증 시 null)"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UserPublic": {
        "type": "object",
        "description": "비밀번호 해시를 제외한 사용자 정보",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "name": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "카테고리 고유 식별자"
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "소유 사용자 ID (기본 카테고리는 null)"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "description": "카테고리 이름"
          },
          "is_default": {
            "type": "boolean",
            "description": "기본 카테고리 여부 (true=시스템 제공, false=사용자 정의)"
          }
        }
      },
      "Todo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "할일 고유 식별자"
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "description": "소유 사용자 ID"
          },
          "category_id": {
            "type": "string",
            "format": "uuid",
            "description": "카테고리 ID (BR-05: 필수)"
          },
          "title": {
            "type": "string",
            "maxLength": 255,
            "description": "할일 제목"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "할일 상세 설명 (선택)"
          },
          "due_date": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "종료 예정일 (YYYY-MM-DD, 선택)"
          },
          "is_completed": {
            "type": "boolean",
            "default": false,
            "description": "완료 여부"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "description": "현재 페이지 번호"
          },
          "limit": {
            "type": "integer",
            "description": "페이지당 항목 수"
          },
          "total": {
            "type": "integer",
            "description": "전체 항목 수"
          },
          "total_pages": {
            "type": "integer",
            "description": "전체 페이지 수"
          }
        }
      },
      "ApiResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "code": {
            "type": "string",
            "description": "응답 코드 (SUCCESS, CREATED, UNAUTHORIZED 등)"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "code": {
            "type": "string",
            "example": "UNAUTHORIZED"
          },
          "message": {
            "type": "string",
            "example": "인증이 필요합니다."
          }
        }
      },
      "SignupRequest": {
        "type": "object",
        "required": ["email", "password", "name"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255,
            "example": "hong@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "description": "8자 이상",
            "example": "password123!"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "example": "홍길동"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "hong@example.com"
          },
          "password": {
            "type": "string",
            "example": "password123!"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "code": { "type": "string", "example": "SUCCESS" },
          "message": { "type": "string", "example": "로그인되었습니다." },
          "data": {
            "type": "object",
            "properties": {
              "access_token": {
                "type": "string",
                "description": "JWT Access Token (15분 만료)"
              },
              "refresh_token": {
                "type": "string",
                "description": "JWT Refresh Token (7일 만료)"
              },
              "user": {
                "$ref": "#/components/schemas/UserPublic"
              }
            }
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "required": ["refresh_token"],
        "properties": {
          "refresh_token": {
            "type": "string",
            "description": "Zustand 메모리에 저장된 Refresh Token"
          }
        }
      },
      "UpdateUserRequest": {
        "type": "object",
        "description": "이름 또는 비밀번호 중 하나 이상 필수. 이메일은 변경 불가 (BR-09)",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "example": "홍길순"
          },
          "current_password": {
            "type": "string",
            "description": "비밀번호 변경 시 현재 비밀번호 필수"
          },
          "new_password": {
            "type": "string",
            "minLength": 8,
            "description": "새 비밀번호 (8자 이상)"
          }
        }
      },
      "CategoryCreateRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "example": "스터디"
          }
        }
      },
      "CategoryUpdateRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "example": "스터디 모임"
          }
        }
      },
      "TodoCreateRequest": {
        "type": "object",
        "required": ["title", "category_id"],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 255,
            "description": "할일 제목 (필수, BR-05)",
            "example": "주간 보고서 작성"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "상세 설명 (선택)",
            "example": "1분기 실적 포함하여 작성"
          },
          "category_id": {
            "type": "string",
            "format": "uuid",
            "description": "카테고리 ID (필수, BR-05)"
          },
          "due_date": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "종료 예정일 YYYY-MM-DD (선택)",
            "example": "2026-05-20"
          }
        }
      },
      "TodoUpdateRequest": {
        "type": "object",
        "description": "변경할 필드만 포함 (부분 업데이트)",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 255
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "category_id": {
            "type": "string",
            "format": "uuid"
          },
          "due_date": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "is_completed": {
            "type": "boolean",
            "description": "완료 여부 토글"
          }
        }
      },
      "TodoListResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "code": { "type": "string", "example": "SUCCESS" },
          "data": {
            "type": "object",
            "properties": {
              "todos": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/Todo" }
              },
              "pagination": {
                "$ref": "#/components/schemas/PaginationMeta"
              }
            }
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "인증 실패 — 토큰 없음, 만료, 또는 유효하지 않음",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "success": false,
              "code": "UNAUTHORIZED",
              "message": "인증이 필요합니다."
            }
          }
        }
      },
      "Forbidden": {
        "description": "접근 권한 없음 — 타인의 데이터 접근 시도 (BR-02)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "success": false,
              "code": "FORBIDDEN",
              "message": "접근 권한이 없습니다."
            }
          }
        }
      },
      "NotFound": {
        "description": "리소스를 찾을 수 없음",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "success": false,
              "code": "NOT_FOUND",
              "message": "리소스를 찾을 수 없습니다."
            }
          }
        }
      },
      "BadRequest": {
        "description": "잘못된 요청 — 필수 필드 누락 또는 유효성 검사 실패",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "success": false,
              "code": "BAD_REQUEST",
              "message": "요청 데이터가 올바르지 않습니다."
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "회원가입",
        "description": "이메일, 비밀번호, 이름으로 신규 계정을 생성합니다.\n\n- **BR-07**: 이메일 중복 등록 불가\n- 가입 성공 시 기본 카테고리(업무·개인·기타)는 시스템에서 공유 제공",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SignupRequest" },
              "example": {
                "email": "hong@example.com",
                "password": "password123!",
                "name": "홍길동"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "회원가입 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "code": { "type": "string", "example": "CREATED" },
                    "message": { "type": "string", "example": "회원가입되었습니다." },
                    "data": { "$ref": "#/components/schemas/UserPublic" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": {
            "description": "이메일 중복 (BR-07)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": {
                  "success": false,
                  "code": "CONFLICT",
                  "message": "이미 사용 중인 이메일입니다."
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "로그인",
        "description": "이메일·비밀번호로 로그인하고 JWT 토큰을 발급받습니다.\n\n- **Access Token**: 15분 만료\n- **Refresh Token**: 7일 만료\n- 두 토큰 모두 프론트엔드 Zustand 메모리에 저장",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" },
              "example": {
                "email": "hong@example.com",
                "password": "password123!"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "로그인 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": {
            "description": "이메일 또는 비밀번호 불일치",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": {
                  "success": false,
                  "code": "UNAUTHORIZED",
                  "message": "이메일 또는 비밀번호가 일치하지 않습니다."
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Access Token 갱신",
        "description": "Refresh Token으로 새 Access Token을 발급받습니다.\n\nAccess Token 만료(401) 시 axios interceptor가 자동으로 이 엔드포인트를 호출합니다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RefreshRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "토큰 갱신 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "code": { "type": "string", "example": "SUCCESS" },
                    "message": { "type": "string", "example": "토큰이 갱신되었습니다." },
                    "data": {
                      "type": "object",
                      "properties": {
                        "access_token": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Refresh Token 만료 또는 유효하지 않음 — 재로그인 필요",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": {
                  "success": false,
                  "code": "UNAUTHORIZED",
                  "message": "Refresh Token이 만료되었습니다. 다시 로그인해주세요."
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "로그아웃",
        "description": "로그아웃 처리합니다.\n\n백엔드는 성공 응답만 반환하며, 프론트엔드는 응답 수신 후 Zustand의 Access Token·Refresh Token을 직접 제거합니다.",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "로그아웃 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "code": { "type": "string", "example": "SUCCESS" },
                    "message": { "type": "string", "example": "로그아웃되었습니다." }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/users/me": {
      "get": {
        "tags": ["Users"],
        "summary": "내 정보 조회",
        "description": "현재 인증된 사용자의 정보를 조회합니다. password_hash는 응답에서 제외됩니다.",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "code": { "type": "string", "example": "SUCCESS" },
                    "data": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "patch": {
        "tags": ["Users"],
        "summary": "내 정보 수정",
        "description": "사용자 이름 또는 비밀번호를 수정합니다.\n\n- **BR-09**: 이메일은 변경 불가\n- 비밀번호 변경 시 `current_password` 필수",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateUserRequest" },
              "examples": {
                "이름 변경": {
                  "value": { "name": "홍길순" }
                },
                "비밀번호 변경": {
                  "value": {
                    "current_password": "password123!",
                    "new_password": "newPassword456!"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "수정 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "code": { "type": "string", "example": "SUCCESS" },
                    "message": { "type": "string", "example": "정보가 수정되었습니다." },
                    "data": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
