        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CategoryUpdateRequest" },
              "example": { "name": "스터디 모임" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "수정 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "code": { "type": "string", "example": "SUCCESS" },
                    "data": { "$ref": "#/components/schemas/Category" }
                  }
                }
              }
